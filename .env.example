# Không điền mật khẩu thật vào tệp này.
# Hãy sao chép thành .env trước khi chạy hệ thống.

DJANGO_SECRET_KEY=doi_khoa_bao_mat_khi_cai_dat
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Để trống POSTGRES_HOST trong Giai đoạn 1 để dùng SQLite cục bộ.
# Các biến này được dùng từ Giai đoạn 3 khi có PostgreSQL/PostGIS.
POSTGRES_DB=ptn_db
POSTGRES_USER=ptn_user
POSTGRES_PASSWORD=doi_mat_khau_khi_cai_dat
POSTGRES_HOST=
POSTGRES_PORT=5432

# Dùng từ Giai đoạn 3 khi cấu hình GeoServer.
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=doi_mat_khau_khi_cai_dat
